# Normalize line endings so a checkout on Windows keeps POSIX helpers runnable.
#
# `scripts/*.sh` are executed by bash and WSL, and `packages/*/scripts/*.mjs` are
# run by Node. A CRLF checkout turns `#!/usr/bin/env bash` into a bad interpreter
# and leaves the scripts showing as modified in every diff.
#
# Nothing under `packages/*/lib/` is tracked (`.gitignore` covers `lib/`), so this
# rule exists for the scripts and sources, not for generated build output.
* text=auto eol=lf

# Windows-only helpers must keep CRLF so cmd.exe and PowerShell can run them.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary assets are never converted.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.tgz binary
*.woff binary
*.woff2 binary
