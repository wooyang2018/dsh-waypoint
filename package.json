{
  "name": "dsh-waypoint-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 build",
    "pretypecheck": "node scripts/check/check-workspace-libs.mjs && pnpm typecheck:scripts",
    "typecheck": "pnpm -r --workspace-concurrency=1 typecheck",
    "typecheck:scripts": "tsc -p scripts/tsconfig.json",
    "test": "pnpm test:scripts && pnpm -r --workspace-concurrency=1 test",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\"",
    "verify": "pnpm build && pnpm test",
    "clean": "node scripts/build/clean.mjs",
    "release:plugin": "node scripts/release/release-plugin.mjs",
    "release:preflight": "node scripts/release/release-preflight.mjs",
    "release:publish": "node scripts/release/publish-local.mjs",
    "release:publish:dry": "node scripts/release/publish-local.mjs --dry-run",
    "test:e2e": "pnpm build && node scripts/build/package-agent.mjs && node scripts/test/test-e2e.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-api-workspace-controller": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.5",
    "@deepseek-ai/dsh-host-webserver": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session-persistence": "0.2.2-rc.5",
    "@deepseek-ai/dsh-storage": "0.2.2-rc.5",
    "@deepseek-ai/dsh-storage-domain": "0.2.2-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.5",
    "@deepseek-ai/dsh-workspace": "0.2.2-rc.5",
    "@deepseek-ai/schemastery": "3.18.5",
    "@dsh-waypoint/testkit": "workspace:*",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.10.0",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@types/react-test-renderer": "18.3.1",
    "esbuild": "^0.25.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-test-renderer": "18.3.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wooyang2018/dsh-waypoint.git"
  },
  "homepage": "https://github.com/wooyang2018/dsh-waypoint#readme",
  "bugs": {
    "url": "https://github.com/wooyang2018/dsh-waypoint/issues"
  },
  "author": "wooyang2018 (fork of Golden-Pigeon/dsh-remote)",
  "license": "MIT"
}
