{
  "name": "dsh-waypoint",
  "version": "1.0.1",
  "description": "DSH remote-development local plugin: host registry, SSH tunnels, remote workspace/session discovery, an authenticated Connection RPC surface, agent tools, and a Settings page.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "remote-development",
    "ssh",
    "deepseek-harness"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "dsh": ">=0.2.2-rc.2 <0.3.0-0"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml",
    "icon-180.png",
    "screenshots",
    "screenshots.json",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    },
    "compatibility": {
      "dsh": ">=0.2.2-rc.2 <0.3.0-0"
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.3",
    "@deepseek-ai/dsh-api-session-controller": "0.2.2-rc.3",
    "@deepseek-ai/dsh-api-terminal-controller": "0.2.2-rc.3",
    "@deepseek-ai/dsh-api-workspace-files": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-session": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-workspace": "0.2.2-rc.3",
    "@deepseek-ai/dsh-credentials": "0.2.2-rc.3",
    "@deepseek-ai/dsh-fs": "0.2.2-rc.3",
    "@deepseek-ai/dsh-sandbox": "0.2.2-rc.3",
    "@deepseek-ai/dsh-scope": "0.2.2-rc.3",
    "@deepseek-ai/dsh-session": "0.2.2-rc.3",
    "@deepseek-ai/dsh-subprocess": "0.2.2-rc.3",
    "@deepseek-ai/dsh-user-approval": "0.2.2-rc.3",
    "@deepseek-ai/dsh-workspace": "0.2.2-rc.3",
    "@deepseek-ai/dsh-workspace-changes": "0.2.2-rc.3",
    "@dsh-waypoint/installer": "workspace:*",
    "@dsh-waypoint/protocol": "workspace:*",
    "dsh-waypoint-agent": "workspace:*",
    "dsh-waypoint-terminal-controller": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.5 <4.2.0",
    "@deepseek-ai/dsh-agent": ">=0.2.2-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-api-session-controller": ">=0.2.2-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-api-terminal-controller": ">=0.2.2-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-api-workspace-files": ">=0.2.2-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-client-connection": ">=0.2.2-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.2.2-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-session": ">=0.2.2-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.2.2-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.2-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-workspace": ">=0.2.2-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-credentials": ">=0.2.2-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-fs": ">=0.2.2-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-sandbox": ">=0.2.2-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-scope": ">=0.2.2-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-session": ">=0.2.2-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-subprocess": ">=0.2.2-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.2.2-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-user-approval": ">=0.2.2-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-workspace": ">=0.2.2-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-workspace-changes": ">=0.2.2-rc.2 <0.3.0-0",
    "@deepseek-ai/schemastery": ">=3.18.0 <4.0.0",
    "react": ">=18.2.0 <19",
    "react-dom": ">=18.2.0 <19"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-api-session-controller": {
      "optional": true
    },
    "@deepseek-ai/dsh-api-terminal-controller": {
      "optional": true
    },
    "@deepseek-ai/dsh-api-workspace-files": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-connection": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-renderer": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-workspace": {
      "optional": true
    },
    "@deepseek-ai/dsh-credentials": {
      "optional": true
    },
    "@deepseek-ai/dsh-fs": {
      "optional": true
    },
    "@deepseek-ai/dsh-sandbox": {
      "optional": true
    },
    "@deepseek-ai/dsh-scope": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-subprocess": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-user-approval": {
      "optional": true
    },
    "@deepseek-ai/dsh-workspace": {
      "optional": true
    },
    "@deepseek-ai/dsh-workspace-changes": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/package-agent.mjs && node ../../scripts/build-host.mjs && node ../../scripts/build-client.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.client.json",
    "test": "node ../../scripts/build-client.mjs && node --import tsx --test test/*.test.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wooyang2018/dsh-waypoint.git",
    "directory": "packages/local-plugin"
  },
  "homepage": "https://github.com/wooyang2018/dsh-waypoint#readme",
  "bugs": {
    "url": "https://github.com/wooyang2018/dsh-waypoint/issues"
  },
  "author": "wooyang2018, based on work by Golden-Pigeon",
  "publishConfig": {
    "access": "public"
  }
}
